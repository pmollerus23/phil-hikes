{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts",
    "src/features/map/model.ts",
    "src/features/map/url.ts"
  ]
}
