---
import Shell from '../layouts/Shell.astro';
---
<Shell>
  <main><p class="eyebrow">A PERSONAL OUTDOOR ARCHIVE</p><h1>A little further<br />off the beaten path.</h1><p class="intro">Miles on foot. Nights under canvas. A collection of routes, campsites, and memories from time outside.</p><a class="explore" href="/map">Explore the trip map <span aria-hidden="true">↗</span></a><div class="landscape" aria-hidden="true"><span>FIELD NOTES / 01</span><svg viewBox="0 0 900 220" fill="none"><path d="M0 200 160 95 225 136 410 12 585 153 680 67 900 210" stroke="currentColor" stroke-width="2"/><path d="m245 130 165-118 82 87-80-39-51 35-22-16M0 210l200-45 100 42 170-77 125 64 167-30 138 52" stroke="currentColor" opacity=".4"/></svg></div></main>
</Shell>
<style>main{max-width:1150px;margin:auto;padding:90px 36px 30px}.eyebrow{font-size:11px;letter-spacing:.2em;color:#69776a}h1{font-family:Georgia,serif;font-weight:400;font-size:clamp(46px,7vw,88px);line-height:1.08;letter-spacing:-.045em;margin:28px 0}.intro{font-size:17px;line-height:1.8;max-width:470px;color:#617062}.explore{margin-top:20px;display:inline-flex;gap:45px;padding:17px 23px;background:#294b39;color:#fff;border-radius:5px;text-decoration:none;font-size:14px}.landscape{margin:60px 0 0;color:#74846c}.landscape span{font-size:10px;letter-spacing:.15em}.landscape svg{display:block;width:100%;max-height:260px}@media(max-width:600px){main{padding:50px 24px}.landscape{margin-top:65px}}</style>
