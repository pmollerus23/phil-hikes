---
const { title = 'Phil’s field notes', map = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" /><meta name="theme-color" content="#f7f6f0" /><meta name="description" content="Routes, campsites, and notes from Phil’s time outside." /><title>{title}</title></head>
  <body class:list={[{ 'map-page': map }]}>
    <header class="site-nav"><a class="wordmark" href="/" aria-label="Phil’s field notes home"><span aria-hidden="true">△</span> PHIL’S FIELD NOTES</a><nav aria-label="Main navigation"><a href="/" aria-current={!map ? 'page' : undefined}>Home</a><a href="/map" aria-current={map ? 'page' : undefined}>Map <span aria-hidden="true">↗</span></a></nav></header>
    <slot />
  </body>
</html>
<style is:global>
  :root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#233b31;background:#f7f6f0;font-synthesis:none;color-scheme:light}*{box-sizing:border-box}body{margin:0}a{color:inherit}button,input,select{font:inherit}button,a,input,select{-webkit-tap-highlight-color:transparent}button{cursor:pointer}button:disabled{cursor:default;opacity:.55}:focus-visible{outline:3px solid #ce5b29;outline-offset:3px}button{color:inherit}.site-nav{height:48px;padding:0 26px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #d8ded5;background:#f7f6f0;position:relative;z-index:5}.wordmark{font-size:11px;letter-spacing:.12em;font-weight:750;text-decoration:none;display:flex;align-items:center;gap:10px}.wordmark span{font-size:28px;font-weight:400}.site-nav nav{display:flex;height:100%;gap:24px;align-items:center}.site-nav nav a{font-size:12px;text-decoration:none;display:flex;align-items:center;gap:9px;height:100%;border-bottom:2px solid transparent}.site-nav nav a[aria-current=page]{border-color:#284d3a;font-weight:700}.map-page{overflow:hidden}@media(max-width:600px){.site-nav{padding:0 15px}.wordmark{font-size:9px;letter-spacing:.07em}.site-nav nav{gap:18px}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition:none!important;animation:none!important}}
</style>
