# Netlify delivery policy. Netlify already provides edge caching and Brotli
# compression; these rules only tune cache lifetimes. Verify actual
# cache-control, content-encoding, and conditional-request behavior after a
# separately authorized deployment: local preview cannot establish it.

# Content-hashed build assets are safe to cache immutably.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Trip JSON keeps stable URLs across imports: reuse validated content without
# hiding updated imports. Stable photo/font names stay on default caching.
/trips/*.json
  Cache-Control: public, max-age=0, must-revalidate

# HTML stays revalidating.
/
  Cache-Control: public, max-age=0, must-revalidate
/map
  Cache-Control: public, max-age=0, must-revalidate
/map/
  Cache-Control: public, max-age=0, must-revalidate
/photo-demo
  Cache-Control: public, max-age=0, must-revalidate
/photo-demo/
  Cache-Control: public, max-age=0, must-revalidate
