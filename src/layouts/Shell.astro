---
const { title = 'Phil’s field notes', map = false } = Astro.props;
const mapKey = import.meta.env.PUBLIC_MAPTILER_KEY?.trim();
---
<!doctype html>
<html lang="en">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" /><meta name="theme-color" content="#ffffff" /><meta name="description" content="Routes, campsites, and notes from Phil’s time outside." />{map && mapKey && <link rel="preconnect" href="https://api.maptiler.com" />}<title>{title}</title></head>
  <body class:list={[{ 'map-page': map }]}>
    <header class="site-nav"><a class="wordmark" href="/" aria-label="Phil’s field notes home"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M3 26 16 4l13 22H3Z M10 14l6 5 5-7" /></svg><span>PHIL’S FIELD NOTES</span></a><nav aria-label="Main navigation"><a href="/" aria-current={!map ? 'page' : undefined}>Home</a><a href="/map" aria-current={map ? 'page' : undefined}>Map <span aria-hidden="true">↗</span></a></nav></header>
    <slot />
  </body>
</html>
<style is:global>
  @font-face{font-family:'Barlow Semi Condensed';src:url('/fonts/barlow-semi-condensed-bold.woff2') format('woff2');font-weight:700;font-style:normal;font-display:swap}
  :root{--ink:#171717;--paper:#fff;--surface:#f5f5f5;--muted:#626262;--rule:#dcdcdc;--accent:#d54300;--heading-font:'Barlow Semi Condensed','Arial Narrow',Arial,sans-serif;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;color:var(--ink);background:var(--paper);font-synthesis:none;color-scheme:light}
  *{box-sizing:border-box}body{margin:0}a{color:inherit}button,input,select{font:inherit}button,a,input,select{-webkit-tap-highlight-color:transparent}button{cursor:pointer;color:inherit}button:disabled{cursor:default;opacity:.55}:focus-visible{outline:3px solid var(--accent);outline-offset:3px}::selection{background:#ffd8c6;color:var(--ink)}
  .site-nav{height:48px;padding:0 26px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--rule);background:var(--paper);position:relative;z-index:5}
  .wordmark{font:700 18px/1 var(--heading-font);letter-spacing:.035em;text-decoration:none;display:flex;align-items:center;gap:10px}.wordmark svg{width:27px;height:27px;fill:none;stroke:currentColor;stroke-width:1.7;flex-shrink:0}
  .site-nav nav{display:flex;height:100%;gap:28px;align-items:center}.site-nav nav a{font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;display:flex;align-items:center;gap:9px;height:100%;border-bottom:3px solid transparent;padding-top:3px}.site-nav nav a[aria-current=page]{border-color:var(--accent)}.site-nav nav a:hover{color:var(--accent)}.map-page{overflow:hidden}
  @media(max-width:600px){.site-nav{padding:0 15px}.wordmark{font-size:15px;letter-spacing:.015em;gap:7px}.wordmark svg{width:23px;height:23px}.site-nav nav{gap:18px}}
  @media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition:none!important;animation:none!important}}
</style>
