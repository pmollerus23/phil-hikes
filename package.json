{
  "name": "phils-hikes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check && tsc --noEmit -p tsconfig.tools.json",
    "import:gpx": "node --import tsx scripts/import-gpx.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "test:map": "MAP_TEST=1 playwright test"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.6",
    "astro": "^7.3.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "maplibre-gl": "^6.10.0",
    "react-map-gl": "^8.1.3",
    "fast-xml-parser": "^5.11.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/node": "^26.6.1",
    "@types/geojson": "^7946.0.16",
    "typescript": "^6.0.3",
    "tsx": "^4.23.13",
    "@playwright/test": "^1.63.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
